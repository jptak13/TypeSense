# Required for signing local sessions. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Existing Create mode provider (default)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative for Create mode. API billing is separate from ChatGPT Plus.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Email verification and password reset (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=TypeSense <noreply@your-domain.example>
# APP_URL=http://localhost:5173

# Optional production configuration
# ALLOWED_ORIGINS=https://your-domain.example
# Hosted PostgreSQL (Supabase works). Include sslmode=require for cloud connections.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# Local development falls back to SQLite when DATABASE_URL is not set.
# DATABASE_PATH=./typesense.db
# PORT=3000
